# ATMOSAIR Environment Configuration Example
# Copy this file to .env and supply your credentials.
# NEVER commit .env to version control.

# Application Environment
ATMOSAIR_ENV=development
LOG_LEVEL=INFO

# 1. Copernicus Climate Data Store (CDS) API
# Register at: https://cds.climate.copernicus.eu/
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=your_cds_api_key_here

# 2. Copernicus Atmosphere Data Store (ADS / CAMS)
# Register at: https://ads.atmosphere.copernicus.eu/
CAMS_API_URL=https://ads.atmosphere.copernicus.eu/api
CAMS_API_KEY=your_cams_api_key_here

# 3. NASA FIRMS (Fire Information for Resource Management System)
# Request MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# 4. Copernicus Data Space Ecosystem (Sentinel-5P / TROPOMI)
# Register at: https://dataspace.copernicus.eu/
SENTINEL_API_CLIENT_ID=your_sentinel_client_id_here
SENTINEL_API_CLIENT_SECRET=your_sentinel_client_secret_here

# 5. CPCB / DPCC Official Ground Observation API (or Central Portal API)
CPCB_API_KEY=your_cpcb_api_key_here
CPCB_API_BASE_URL=https://app.cpcbccr.com/caaqms

# 6. WRF Forecast Data Directory / NetCDF Storage
WRF_OUTPUT_DIR=data/wrf_output
WRF_GRID_RESOLUTION_KM=3.0

# 7. Cache & Storage Configuration
CACHE_TTL_OBSERVATIONS_SEC=3600
CACHE_TTL_CAMS_SEC=21600
CACHE_TTL_FIRMS_SEC=10800
CACHE_TTL_WRF_SEC=21600
