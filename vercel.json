{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/dashboard/assets/(.*)", "destination": "/dashboard/assets/$1" },
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/dashboard/index.html", "destination": "/dashboard/index.html" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
